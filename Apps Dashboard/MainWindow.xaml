<Window x:Class="Apps_Dashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:helpers="clr-namespace:Apps_Dashboard.Helpers"
        AllowsTransparency="True" Background="#12000000" BorderBrush="#A0DD861C" BorderThickness="1"
        Title="Apps Dashboard" Width="1400" Height="740" Topmost="True" WindowStartupLocation="CenterScreen"
        WindowStyle="None" Loaded="Window_Loaded" MouseDown="Window_MouseDown">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="XamlStyles/StylesForMainWindow.xaml"/>
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid x:Name="DashboardRoot" Margin="5">
        <Button Name="btnOptions" Width="36" Height="36" Margin="0,47,3,0" HorizontalAlignment="Right" VerticalAlignment="Top" Click="btnOptions_Click" Panel.ZIndex="55" Style="{StaticResource DarkOptionsButton}">
            <Image Width="30" Source="Options.png"/>
        </Button>
        <Button Width="36" Height="36" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,3,0" Style="{StaticResource TileActionButton}" Click="NewGroup_Click" ToolTip="Nowa grupa">
            <Path Data="M 13,1 L 13,25 M 1,13 L 25,13" Width="26" Height="26" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Button>
        <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden" Margin="0,0,42,0">
            <ItemsControl x:Name="GroupsControl" ItemsSource="{Binding AppsGroups}" AllowDrop="True" DragOver="Board_DragOver" Drop="Board_Drop">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><helpers:SpatialGroupsPanel Background="Transparent"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate>
                                        <Border x:Name="GroupCard" Margin="5" Padding="7,4,7,5" CornerRadius="9" BorderThickness="1" BorderBrush="{Binding Outline}" Background="{Binding Tint}">
                    <Grid ClipToBounds="True">
                        <Border Opacity="0.38" IsHitTestVisible="False" Margin="-12">
                            <Border.Background><ImageBrush ImageSource="{Binding Texture}" Stretch="UniformToFill"/></Border.Background>
                            <Border.Effect><BlurEffect Radius="14"/></Border.Effect>
                        </Border>
                    <StackPanel>
                        <Grid x:Name="GroupHeader" Background="Transparent" Margin="2,0,2,2" PreviewMouseLeftButtonDown="Group_MouseDown" PreviewMouseLeftButtonUp="Group_MouseUp" PreviewMouseMove="Group_MouseMove">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding GroupName}" FontWeight="SemiBold" FontSize="13" Foreground="{Binding Accent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <StackPanel x:Name="GroupActions" Grid.Column="1" Orientation="Horizontal" Opacity="0">
                                <Button Width="32" Height="32" Foreground="{Binding Accent}" Style="{StaticResource TileActionButton}" Click="EditGroup_Click" ToolTip="Edytuj grupę">
                                    <Path Data="M 3,15 L 15,3 L 19,7 L 7,19 L 2,20 Z M 12,6 L 16,10" Width="22" Height="22" Stroke="{Binding Accent}" StrokeThickness="1.8" StrokeLineJoin="Round"/>
                                </Button>
                                <Button Width="32" Height="32" Foreground="{Binding Accent}" Style="{StaticResource TileActionButton}" Click="AddGroupApp_Click" ToolTip="Dodaj aplikację">
                                    <Path Data="M 11,1 L 11,21 M 1,11 L 21,11" Width="22" Height="22" Stroke="{Binding Accent}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Button>
                                <TextBlock Text="⠿" FontSize="25" Foreground="{Binding Accent}" Width="28" VerticalAlignment="Center" TextAlignment="Center" Cursor="SizeAll" ToolTip="Przeciągnij grupę"/>
                            </StackPanel>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Apps}" AllowDrop="True" DragOver="Apps_DragOver" Drop="Apps_Drop">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><helpers:SpatialAppPanel Background="Transparent"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Grid x:Name="Tile" Loaded="Tile_Loaded" Width="90" VerticalAlignment="Top" Margin="0,3,4,3" Background="Transparent">
                                    <Border x:Name="Frame" BorderThickness="1" CornerRadius="8" BorderBrush="Transparent" Background="Transparent"/>
                                    <Button Margin="3,25,3,7" Style="{StaticResource AppIconButton}" Command="{Binding DataContext.LaunchAppCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Path}">
                                        <StackPanel Width="84">
                                            <Grid Width="38" Height="38" Margin="0,0,0,3">
                                                <TextBlock Text="▧" FontSize="28" Foreground="#AEB9C8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Image x:Name="AppImage" Source="{Binding Icon}" Width="32" Height="32" RenderTransformOrigin="0.5,0.5"><Image.RenderTransform><ScaleTransform/></Image.RenderTransform></Image>
                                            </Grid>
                                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource GroupHeaderStyle}" TextAlignment="Center" TextWrapping="Wrap" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="Edit" Style="{StaticResource TileActionButton}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2,2,0,0" Visibility="Hidden" Click="EditTile_Click" ToolTip="Edytuj nazwę i ścieżkę">
                                        <Path Data="M 3,11 L 11,3 L 14,6 L 6,14 L 2,15 Z M 9,5 L 12,8" Stroke="White" StrokeThickness="1.4" Width="17" Height="17"/>
                                    </Button>
                                    <Button x:Name="Actions" Content="⋮" FontSize="19" Style="{StaticResource TileActionButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0" Visibility="Hidden" Click="TileActions_Click" PreviewMouseLeftButtonDown="Handle_MouseDown" PreviewMouseMove="Handle_MouseMove" ToolTip="Akcje • przeciągnij, aby zmienić kolejność"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Frame" Property="BorderBrush" Value="{Binding DataContext.Accent, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/><Setter TargetName="Frame" Property="Background" Value="#3024272E"/>
                                        <Setter TargetName="Edit" Property="Visibility" Value="Visible"/><Setter TargetName="Actions" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                    <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                                        <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="AppImage" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1.12" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="AppImage" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1.12" Duration="0:0:0.15"/>
                                        </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                        <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="AppImage" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="AppImage" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.15"/>
                                        </Storyboard></BeginStoryboard></Trigger.ExitActions>
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel></Grid></Border>
                    <DataTemplate.Triggers>
                        <Trigger SourceName="GroupHeader" Property="IsMouseOver" Value="True">
                            <Setter TargetName="GroupActions" Property="Opacity" Value="1"/>
                        </Trigger>
                    </DataTemplate.Triggers>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>





