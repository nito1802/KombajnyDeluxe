<Window x:Class="Apps_Dashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AllowsTransparency="True" Background="#12000000" BorderBrush="#A0DD861C" BorderThickness="1"
        Title="Apps Dashboard" Width="1400" Height="740" Topmost="True" WindowStartupLocation="CenterScreen"
        WindowStyle="None" Loaded="Window_Loaded" MouseDown="Window_MouseDown">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="XamlStyles/StylesForMainWindow.xaml"/>
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid x:Name="DashboardRoot" Margin="5">
        <Button Name="btnOptions" Margin="0,5,5,0" HorizontalAlignment="Right" VerticalAlignment="Top" Click="btnOptions_Click" Panel.ZIndex="55" Style="{StaticResource DarkOptionsButton}">
            <Image Width="30" Source="Options.png"/>
        </Button>
        <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" Margin="0,0,42,0">
            <ItemsControl ItemsSource="{Binding AppsGroups}">
                <ItemsControl.ItemTemplate><DataTemplate>
                    <StackPanel Margin="10">
                        <TextBlock Text="{Binding GroupName}" FontWeight="Bold" FontSize="16" Foreground="#FFF1F1F1" Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding Apps}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Grid x:Name="Tile" Loaded="Tile_Loaded" Width="90" VerticalAlignment="Top" Margin="0,3,4,3" Background="Transparent" AllowDrop="True" DragOver="Tile_DragOver" DragLeave="Tile_DragLeave" Drop="Tile_Drop">
                                    <Border x:Name="Frame" BorderThickness="1" CornerRadius="8" BorderBrush="Transparent" Background="Transparent"/>
                                    <Button Margin="3,25,3,7" Style="{StaticResource AppIconButton}" Command="{Binding DataContext.LaunchAppCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Path}">
                                        <StackPanel Width="84">
                                            <Grid Width="38" Height="38" Margin="0,0,0,3">
                                                <TextBlock Text="▧" FontSize="28" Foreground="#AEB9C8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Image x:Name="AppImage" Source="{Binding Icon}" Width="32" Height="32" RenderTransformOrigin="0.5,0.5"><Image.RenderTransform><ScaleTransform/></Image.RenderTransform></Image>
                                            </Grid>
                                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource GroupHeaderStyle}" TextAlignment="Center" TextWrapping="Wrap" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="Edit" Style="{StaticResource TileActionButton}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2,2,0,0" Visibility="Hidden" Click="EditTile_Click" ToolTip="Edytuj nazwę i ścieżkę">
                                        <Path Data="M 3,11 L 11,3 L 14,6 L 6,14 L 2,15 Z M 9,5 L 12,8" Stroke="White" StrokeThickness="1.4" Width="17" Height="17"/>
                                    </Button>
                                    <Button x:Name="Actions" Content="⋮" FontSize="19" Style="{StaticResource TileActionButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0" Visibility="Hidden" Click="TileActions_Click" PreviewMouseLeftButtonDown="Handle_MouseDown" PreviewMouseMove="Handle_MouseMove" ToolTip="Akcje • przeciągnij, aby zmienić kolejność"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Frame" Property="BorderBrush" Value="#C99045"/><Setter TargetName="Frame" Property="Background" Value="#3024272E"/>
                                        <Setter TargetName="Edit" Property="Visibility" Value="Visible"/><Setter TargetName="Actions" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                    <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                                        <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="AppImage" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1.12" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="AppImage" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1.12" Duration="0:0:0.15"/>
                                        </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                        <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="AppImage" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="AppImage" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.15"/>
                                        </Storyboard></BeginStoryboard></Trigger.ExitActions>
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>

