<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="ContextMenu">
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
            <Border Background="#24272E" BorderBrush="#4B586E" BorderThickness="1" CornerRadius="7" Padding="5">
                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
            </Border>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="#F1F1F1"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
            <Border x:Name="Row" Background="Transparent" CornerRadius="4" Padding="14,8" MinWidth="140">
                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="#465365"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="AppIconButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="#FFF1F1F1"/>
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="Button"><Border Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style x:Key="TileActionButton" TargetType="Button" BasedOn="{StaticResource AppIconButton}">
        <Setter Property="Width" Value="24"/><Setter Property="Height" Value="24"/>
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="Button">
                <Border x:Name="Chrome" Background="#EE24272E" BorderBrush="#596476" BorderThickness="1" CornerRadius="5">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#465365"/><Setter TargetName="Chrome" Property="BorderBrush" Value="#E4A34C"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style x:Key="DarkOptionsButton" TargetType="Button" BasedOn="{StaticResource AppIconButton}">
        <Setter Property="Opacity" Value="0.8"/>
        <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.4"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="GroupHeaderStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="#FFF1F1F1"/></Style>
</ResourceDictionary>
