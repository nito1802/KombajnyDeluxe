<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="KombajnDoPracy.MainWindow"
        Title="Work Board"
        Width="1320"
        SizeToContent="Height"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        Background="#202020"
        PointerPressed="Window_OnPointerPressed"
        KeyDown="Window_OnKeyDown">
  <Grid Name="MainGrid">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Button Name="OptionsButton"
            Grid.Row="0"
            HorizontalAlignment="Right"
            Margin="0,5,5,0"
            Click="OptionsButton_OnClick">
      <Image Width="25" Source="avares://WorkBoard/Options.png"/>
    </Button>

    <StackPanel Grid.Row="1" Margin="10,40,10,10" Spacing="10">
      <Grid Margin="0,0,0,10">
        <Grid.RowDefinitions>
          <RowDefinition Height="50" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="320" />
          <ColumnDefinition Width="158" />
          <ColumnDefinition Width="320" />
          <ColumnDefinition Width="158" />
          <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <Border Margin="5" Padding="5" BorderBrush="#FF023D15" BorderThickness="1">
          <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="25" FontWeight="Bold"
                     Foreground="#FFCBCBCB" Text="{Binding LeftGroupName}" />
        </Border>

        <Border Grid.Column="2" Margin="5" Padding="5" BorderBrush="#FF053375" BorderThickness="1">
          <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="25" FontWeight="Bold"
                     Foreground="#FFCBCBCB" Text="{Binding MiddleGroupName}" />
        </Border>

        <Border Grid.Column="4" Margin="5" Padding="5" BorderBrush="#FF323232" BorderThickness="1">
          <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="25" FontWeight="Bold"
                     Foreground="#FFCBCBCB" Text="{Binding RightGroupName}" />
        </Border>

        <ItemsControl Name="LeftGroup"
                      Grid.Row="1"
                      ItemsSource="{Binding LeftButtons}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Margin="5" Padding="10" Command="{Binding OpenOrRestoreWindowCommand}" ToolTip.Tip="{Binding Path}">
                <StackPanel>
                  <TextBlock HorizontalAlignment="Center" FontSize="20" Foreground="#FFCBCBCB" Text="{Binding Name}" />
                  <TextBlock HorizontalAlignment="Center" FontSize="10" Foreground="#FFD6D6D6" Text="{Binding Description}"
                             TextWrapping="Wrap" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl Name="MiddleGroup"
                      Grid.Row="1"
                      Grid.Column="2"
                      ItemsSource="{Binding MiddleButtons}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Margin="5" Padding="10" Command="{Binding OpenOrRestoreWindowCommand}" ToolTip.Tip="{Binding Path}">
                <StackPanel>
                  <TextBlock HorizontalAlignment="Center" FontSize="20" Foreground="#FFCBCBCB" Text="{Binding Name}" />
                  <TextBlock HorizontalAlignment="Center" FontSize="10" Foreground="#FFD6D6D6" Text="{Binding Description}"
                             TextWrapping="Wrap" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl Name="RightGroup"
                      Grid.Row="1"
                      Grid.Column="4"
                      ItemsSource="{Binding RightButtons}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Margin="5" Padding="10" Command="{Binding OpenOrRestoreWindowCommand}" ToolTip.Tip="{Binding Path}">
                <StackPanel>
                  <TextBlock HorizontalAlignment="Center" FontSize="20" Foreground="#FFCBCBCB" Text="{Binding Name}" />
                  <TextBlock HorizontalAlignment="Center" FontSize="10" Foreground="#FFD6D6D6" Text="{Binding Description}"
                             TextWrapping="Wrap" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>

      <ItemsControl Name="LinkGroup" Width="1276" ItemsSource="{Binding LinkButtons}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Width="250" Margin="5,0,0,5" Padding="5" Command="{Binding OpenUrlCommand}">
              <Button.ContextFlyout>
                <ContextMenu>
                  <MenuItem Header="Copy path" Command="{Binding CopyPath}" />
                  <MenuItem Header="Copy name + path" Command="{Binding CopyNameWithPath}" />
                </ContextMenu>
              </Button.ContextFlyout>
              <StackPanel Width="230">
                <TextBlock HorizontalAlignment="Center" FontSize="15" FontWeight="Bold" Foreground="#FFCBCBCB"
                           Text="{Binding Name}" />
                <TextBlock Height="50" FontSize="10" Foreground="#FFC29C0F" Text="{Binding Path}"
                           TextWrapping="WrapWithOverflow" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Grid>
</Window>
