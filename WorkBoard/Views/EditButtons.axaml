<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="KombajnDoPracy.Views.EditButtons"
        Width="1325"
        SizeToContent="Height"
        Background="#2C2C2C"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_OnKeyDown"
        Title="Edit Buttons">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
    <StackPanel Margin="15 20 15 15" Spacing="10">
      <Grid ColumnDefinitions="320,158,320,158,325" RowDefinitions="Auto,Auto,Auto">
        <TextBox Grid.Column="0" Text="{Binding LeftGroupName}" HorizontalAlignment="Center" Width="310" />
        <TextBox Grid.Column="2" Text="{Binding MiddleGroupName}" HorizontalAlignment="Center" Width="310" />
        <TextBox Grid.Column="4" Text="{Binding RightGroupName}" HorizontalAlignment="Center" Width="310" />
      </Grid>

      <TextBlock Text="Left buttons" FontWeight="Bold"/>
      <ItemsControl ItemsSource="{Binding LeftButtons}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Margin="5" Padding="5" Background="#33056C26" Width="220">
              <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBox Width="70" Text="{Binding Name}" />
                  <TextBox Width="70" Text="{Binding Description}" />
                  <TextBox Width="70" Text="{Binding Path}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Button Content="Insert" Command="{Binding InsertButton}" IsEnabled="{Binding CanDelete}" />
                  <Button Content="Delete" Command="{Binding DeleteButton}" IsEnabled="{Binding CanDelete}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Button Content="++" Command="{Binding IdxButtonUp}" IsEnabled="{Binding CanDelete}" />
                  <Button Content="--" Command="{Binding IdxButtonDown}" IsEnabled="{Binding CanDelete}" />
                  <TextBlock Text="{Binding ClickCounter, StringFormat={}{0}x}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="Middle buttons" FontWeight="Bold"/>
      <ItemsControl ItemsSource="{Binding MiddleButtons}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Margin="5" Padding="5" Background="#330F499C" Width="220">
              <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBox Width="70" Text="{Binding Name}" />
                  <TextBox Width="70" Text="{Binding Description}" />
                  <TextBox Width="70" Text="{Binding Path}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Button Content="Insert" Command="{Binding InsertButton}" IsEnabled="{Binding CanDelete}" />
                  <Button Content="Delete" Command="{Binding DeleteButton}" IsEnabled="{Binding CanDelete}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Button Content="++" Command="{Binding IdxButtonUp}" IsEnabled="{Binding CanDelete}" />
                  <Button Content="--" Command="{Binding IdxButtonDown}" IsEnabled="{Binding CanDelete}" />
                  <TextBlock Text="{Binding ClickCounter, StringFormat={}{0}x}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="Right buttons" FontWeight="Bold"/>
      <ItemsControl ItemsSource="{Binding RightButtons}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Margin="5" Padding="5" Background="#331B1B1B" Width="220">
              <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBox Width="70" Text="{Binding Name}" />
                  <TextBox Width="70" Text="{Binding Description}" />
                  <TextBox Width="70" Text="{Binding Path}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Button Content="Insert" Command="{Binding InsertButton}" IsEnabled="{Binding CanDelete}" />
                  <Button Content="Delete" Command="{Binding DeleteButton}" IsEnabled="{Binding CanDelete}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Button Content="++" Command="{Binding IdxButtonUp}" IsEnabled="{Binding CanDelete}" />
                  <Button Content="--" Command="{Binding IdxButtonDown}" IsEnabled="{Binding CanDelete}" />
                  <TextBlock Text="{Binding ClickCounter, StringFormat={}{0}x}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="Links" FontWeight="Bold"/>
      <ItemsControl ItemsSource="{Binding UrlButtons}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Margin="5" Padding="5" Background="#33272727" Width="220">
              <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBox Width="70" Text="{Binding Name}" />
                  <TextBox Width="70" Text="{Binding Description}" />
                  <TextBox Width="70" Text="{Binding Path}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Button Content="Insert" Command="{Binding InsertButton}" IsEnabled="{Binding CanDelete}" />
                  <Button Content="Delete" Command="{Binding DeleteButton}" IsEnabled="{Binding CanDelete}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Button Content="++" Command="{Binding IdxButtonUp}" IsEnabled="{Binding CanDelete}" />
                  <Button Content="--" Command="{Binding IdxButtonDown}" IsEnabled="{Binding CanDelete}" />
                  <TextBlock Text="{Binding ClickCounter, StringFormat={}{0}x}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
        <Button Name="SaveButton" Width="120" Content="Save & Close" Click="SaveButton_OnClick" />
        <Button Name="CancelButton" Width="80" Content="Cancel" Click="CancelButton_OnClick" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
